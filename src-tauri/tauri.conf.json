{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bilal Invoice",
  "version": "3.0.3",
  "identifier": "com.bilal.invoice",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bilal Invoice",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bilal"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/codecomfortcc/bilal-invoice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NDUxRUYyRUZEMjk0ODEKUldTQmxOTHY4aDVGWkt0bEpqc3ZsTXpYdXdRRTdKQ0hCeGZEMFc2Q3RLVTNHa2dzU1EwazNKYisK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
